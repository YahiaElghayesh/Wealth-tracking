# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks

# Exception: the debug keystore is intentionally committed (fixed,
# well-known password, zero security value) so CI signs every debug build
# identically and updates install in place instead of wiping local data.
!app/debug.keystore
