<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Bank SMS detection (Settings > Bank SMS detection) — requested at
         runtime, off by default, only for a card charge/payment alert. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS"/>
    <!-- Android 13+ (API 33) requires this to be both declared here AND
         granted at runtime before NotificationManager.notify() does
         anything — without it, SmsReceiver.kt's notify() call silently
         no-ops: the SMS is genuinely detected, but nothing ever appears,
         with no error anywhere to explain why. Requested alongside SMS
         permission itself in bank_sms_settings_screen.dart, since the
         whole feature is built around that notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- App-open fingerprint/Face ID lock (Settings > Security), off by
         default. USE_BIOMETRIC is a normal (not runtime-prompted)
         permission; local_auth's own authenticate() call is what
         surfaces the actual system fingerprint/face UI. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- Settings > App updates' "Install" step: Android requires this
         declared permission (plus the per-app "Install unknown apps" toggle
         AppUpdater.kt sends the user to grant) before ACTION_VIEW on a
         downloaded .apk does anything. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Settings > Bank SMS detection's battery-restriction check/fix
         button: without this, Android can silently delay or drop the
         background WorkManager task that carries a detected charge/payment
         SMS to the card-balance update once the app hasn't been opened in
         a while. This is what lets bank_sms_settings_screen.dart send the
         user straight to the "allow unrestricted background activity"
         prompt for this app specifically, instead of a generic battery
         settings page they'd have to navigate manually. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- Recurring payments (Recurring payments tab): a 'manual' payment's
         reminder is restored after a device restart — AlarmManager forgets
         every alarm it was holding across a reboot. See
         RecurringPaymentReminderBootReceiver.kt. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- SmsReceiver.kt: a short, self-expiring CPU wake lock held across the
         handoff to WorkManager. A normal (not runtime-prompted) permission —
         see SmsReceiver.kt's own comment on why this exists. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <application
        android:label="Money Hub"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <receiver
            android:name=".NetWorthWidgetProvider"
            android:exported="true"
            android:label="Net Worth">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/net_worth_widget_info" />
        </receiver>

        <receiver
            android:name=".NetWorthCompactWidgetProvider"
            android:exported="true"
            android:label="Net Worth (compact)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/net_worth_compact_widget_info" />
        </receiver>

        <receiver
            android:name=".QuickAddLedgerWidgetProvider"
            android:exported="true"
            android:label="Add Payment">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_add_ledger_widget_info" />
        </receiver>

        <activity
            android:name=".QuickAddLedgerWidgetConfigureActivity"
            android:exported="true"
            android:theme="@style/LaunchTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Native, plugin-free bank SMS capture — see SmsReceiver.kt for
             why this isn't a Flutter plugin. android:exported must be true
             for the system to deliver SMS_RECEIVED at all; android:permission
             restricts who's allowed to send us that broadcast to the
             platform itself. Only ever receives anything once the user has
             granted RECEIVE_SMS from Settings > Bank SMS detection. -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED"/>
            </intent-filter>
        </receiver>

        <!-- Recurring payments: fires a manual payment's reminder and
             re-arms the next one 4 hours later — see
             RecurringPaymentReminder.kt. Only ever invoked via the
             PendingIntent this app's own AlarmManager alarm carries. -->
        <receiver
            android:name=".RecurringPaymentReminderReceiver"
            android:exported="false" />

        <!-- Only ever invoked via the "Done" PendingIntent the reminder
             notification above attaches to itself. -->
        <receiver
            android:name=".RecurringPaymentReminderDoneActionReceiver"
            android:exported="false" />

        <!-- Restores every still-pending manual-payment reminder after a
             device restart — BOOT_COMPLETED is a protected system
             broadcast (only the platform itself can send it), so this stays
             unexported. -->
        <receiver
            android:name=".RecurringPaymentReminderBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>

        <!-- flutter_local_notifications' own receiver for a
             `showsUserInterface: false` notification action — unused by
             this app since the SMS charge-review notification's "Quick
             add" button was removed (see sms_rule_notifications.dart's own
             doc comment: it's a plain body tap now, not a separate action,
             after a real device reported the button silently swallowing a
             tap during the notification's heads-up pop-up). Left declared
             rather than removed, since the plugin builds a PendingIntent
             targeting this exact class whenever *any* app-defined action
             exists, and, unlike every other plugin's Android component,
             does NOT declare it in its own manifest — the plugin's own
             README says the *app* must add this receiver itself, so
             removing it now would just be a landmine for the next
             `showsUserInterface: false` action this app ever adds.
             Exported false: this is only ever invoked by a PendingIntent
             this same app created for itself. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            android:exported="false" />

        <!-- Hands the system package installer a content:// URI for the
             downloaded update APK (see AppUpdater.kt) without exposing this
             app's whole cache dir to every other app on the device. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
