<?xml version="1.0" encoding="utf-8"?>
<!-- Exposes only the app's own cache dir, exactly where the update
     downloader (app_update_service.dart) saves the APK, through the
     FileProvider declared in AndroidManifest.xml, so the system installer
     can read a content:// URI for it without this app granting broader
     file access than that one download needs. -->
<paths>
    <cache-path name="updates" path="." />
</paths>
